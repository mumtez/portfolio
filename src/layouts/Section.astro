---
/**
 * A content Section: its heading as the only h1, then its content. On a top-level
 * Section the h1 is visually hidden (the nav marks where you are) but still announced;
 * on a Deep Dive it shows at the top of the Body Text.
 */
import type { Section } from "../lib/content";
import Base from "./Base.astro";

type Props = Omit<Section, "nav" | "order"> & {
  /** A Deep Dive, which isn't in the nav, so shows its heading. */
  deepDive?: boolean;
};

const { path, heading, title, description, deepDive = false } = Astro.props;
---

<Base title={title} description={description} path={path}>
  <main class="section">
    <h1 class:list={{ "visually-hidden": !deepDive }}>{heading}</h1>
    <slot />
  </main>
</Base>

<style>
  .section {
    max-width: 44rem;
    margin: 0 auto;
    padding: 24px 16px 64px;
    line-height: 1.55;
  }
  .section :global(h1) {
    font-size: clamp(2rem, 6vw, 3rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  /* Not at the top of a Panel, where its padding is the gap. */
  .section :global(h2:not(:first-child)) {
    margin-top: 2em;
  }
  .section :global(.meta) {
    margin-top: -0.75em;
    opacity: 0.8;
  }

  /* Plain View: the content starts right under the header; a Deep Dive's title sets tight. */
  :global(html:not(.grid-on)) .section > :global(:first-child),
  :global(html:not(.grid-on)) .section > :global(.visually-hidden + *) {
    margin-top: 0;
  }
  :global(html:not(.grid-on)) .section :global(h1) {
    margin-bottom: 0.5em;
    line-height: 1.15;
  }

  /* Grid on: the whole width scrolls, with the content kept in the same centred column. */
  :global(html.grid-on) .section {
    max-width: none;
    margin: 0;
    padding: 0 max(16px, calc((100% - 44rem) / 2)) 64px;
  }
  :global(html.grid-on) .section > :global(:first-child),
  :global(html.grid-on) .section > :global(.visually-hidden + *) {
    margin-top: 0;
  }
</style>
