---
import Analytics from "../components/Analytics.astro";
import SharingMeta from "../components/SharingMeta.astro";
import SiteNav from "../components/SiteNav.astro";
import { DARK, LIGHT, type Palette } from "../grid/palette";
import { getGridContent } from "../lib/content";
import { THEME_SCRIPT } from "../lib/preferences";

interface Props {
  title: string;
  description: string;
  /** This Section's path, for the nav. */
  path: string;
}

const { title, description, path } = Astro.props;
// What the Grid draws in cells, from the same content as this page. `<` is escaped so
// no heading can close the script element.
const gridContent = JSON.stringify(await getGridContent()).replace(/</g, "\\u003c");

// Both themes' colours, from the palettes the Grid draws with. Dark unless the system
// prefers light; a `data-theme` set by the theme script (or the toggle) overrides both.
const vars = (p: Palette) => `--bg: ${p.background}; --text: ${p.text}; --accent: ${p.pinned};`;
const themeCss = `
  :root { color-scheme: dark; ${vars(DARK)} }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]) { color-scheme: light; ${vars(LIGHT)} }
  }
  :root[data-theme="light"] { color-scheme: light; ${vars(LIGHT)} }
`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline set:html={THEME_SCRIPT} />
    <Fragment set:html={`<style>${themeCss}</style>`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <SharingMeta title={title} description={description} path={path} />
    <Analytics />
  </head>
  <body>
    <canvas id="grid" aria-hidden="true"></canvas>
    <header>
      <SiteNav current={path} />
      <div class="toggles" role="group" aria-label="Display" hidden>
        <button type="button" data-toggle="theme" aria-pressed="false">
          Dark theme
        </button>
        <button type="button" data-toggle="simulation" aria-pressed="false">
          Life simulation
        </button>
      </div>
    </header>
    <slot />
    <script type="application/json" id="grid-content" set:html={gridContent} />
  </body>
</html>

<script>
  import type { GridContent } from "../grid/routes";
  import { startToggles } from "../grid/toggles";

  const canvas = document.querySelector<HTMLCanvasElement>("#grid");
  const data = document.querySelector("#grid-content")?.textContent;

  // The toggles start the Grid unless the simulation is off (by default under reduced
  // motion), which leaves the Plain View: no Grid, ordinary page loads.
  if (canvas && data) startToggles({ canvas, content: JSON.parse(data) as GridContent });
</script>

<style is:global>
  html {
    background: var(--bg);
    color: var(--text);
    font-family:
      system-ui,
      -apple-system,
      "Segoe UI",
      sans-serif;
  }
  body {
    margin: 0;
  }
  a {
    color: var(--accent);
  }
  #grid {
    display: none;
  }

  /*
   * Panels: blocks of Body Text inside a border. With the Grid on, the border is drawn in
   * Pinned Cells, snapped to the cell grid, so the padding is wide enough (over one and a
   * half cells) to keep the text clear of it. In Plain View it's a thin line in the
   * theme's pinned green, dashed for a Placeholder.
   */
  [data-panel] {
    box-sizing: border-box;
    margin: 1.5em 0;
    padding: 16px 20px;
    border: 1px solid transparent;
  }
  [data-panel] > :first-child {
    margin-top: 0;
  }
  [data-panel] > :last-child {
    margin-bottom: 0;
  }
  html:not(.grid-on) [data-panel] {
    border-color: var(--accent);
    border-radius: 4px;
  }
  html:not(.grid-on) [data-panel="dashed"] {
    border-style: dashed;
  }

  .toggles {
    display: flex;
  }
  .toggles[hidden] {
    display: none;
  }
  .toggles button {
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    cursor: pointer;
  }
  .toggles button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /*
   * Plain View: a reading layout of its own. The header shares the content's centred
   * column: the nav's row of links, then the toggles as a quiet text switch at its end
   * ("Theme: dark · Life: off"), wrapping under the nav on a phone.
   */
  html:not(.grid-on) header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 32px;
    max-width: 44rem;
    margin: 0 auto;
    padding: 20px 16px 0;
  }
  /*
   * The switch's words are drawn by CSS from each button's pressed state, with empty
   * alternative text, so the buttons keep their own names ("Dark theme", "Life
   * simulation") and `aria-pressed` says the state. The name itself is hidden by size.
   */
  html:not(.grid-on) .toggles button {
    padding: 4px 0;
    font-size: 0;
    line-height: 1.4;
  }
  html:not(.grid-on) .toggles button::before,
  html:not(.grid-on) .toggles button::after {
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
  }
  html:not(.grid-on) .toggles button::before {
    opacity: 0.7;
  }
  html:not(.grid-on) .toggles button::after {
    color: var(--accent);
    text-decoration: underline 1px;
    text-underline-offset: 3px;
  }
  html:not(.grid-on) .toggles button:hover::after {
    text-decoration-thickness: 2px;
  }
  html:not(.grid-on) [data-toggle="theme"]::before {
    content: "Theme: ";
    content: "Theme: " / "";
  }
  html:not(.grid-on) [data-toggle="simulation"]::before {
    content: " · Life: ";
    content: " · Life: " / "";
    white-space: pre;
  }
  html:not(.grid-on) [data-toggle="theme"]::after {
    content: "light";
    content: "light" / "";
  }
  html:not(.grid-on) [data-toggle="theme"][aria-pressed="true"]::after {
    content: "dark";
    content: "dark" / "";
  }
  html:not(.grid-on) [data-toggle="simulation"]::after {
    content: "off";
    content: "off" / "";
  }
  html:not(.grid-on) [data-toggle="simulation"][aria-pressed="true"]::after {
    content: "on";
    content: "on" / "";
  }

  /*
   * Grid on: Home's name and the nav are drawn in Pinned Cells. The real nav links sit
   * transparently over their cells (placed by the Grid script), and the Section's
   * content scrolls in its own box below the nav (on Home, below the name), over the
   * live Grid.
   */
  html.grid-on #grid {
    display: block;
    position: fixed;
    inset: 0;
  }
  html.grid-on header {
    position: fixed;
    inset: 0 0 auto;
    height: 0;
    z-index: 2;
  }
  html.grid-on header nav > ul > li > a.on-grid {
    position: fixed;
    color: transparent;
    border-radius: 4px;
  }
  html.grid-on header nav > ul > li > a.on-grid:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  /* The toggles' real buttons, likewise, over the small icon Buttons drawn in the corner. */
  html.grid-on .toggles button.on-grid {
    position: fixed;
    padding: 0;
    border-color: transparent;
    background: transparent;
    color: transparent;
  }
  /* Home's name is drawn in cells, so its h1 is hidden like a top-level Section's. */
  .visually-hidden,
  html.grid-on main.home h1 {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  html.grid-on main {
    position: fixed;
    top: calc(var(--below-title, 45vh) + 1.25rem);
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1;
    overflow-y: auto;
    text-shadow: 0 0 6px var(--bg);
  }
  /* Room after the content, so its end scrolls clear of the toggles in the corner. */
  html.grid-on main::after {
    content: "";
    display: block;
    height: var(--toggles-clearance, 0px);
  }
  /*
   * A Section leaving in a Transition: its Body Text fades out over its lines dissolving
   * into Life, before the next Section replaces it (`LEAVE_MS` in the Grid script).
   */
  html.grid-on main.leaving {
    opacity: 0;
    pointer-events: none;
    transition: opacity 240ms ease-in;
  }
  /*
   * A Section arriving in a Transition: its Body Text stays hidden while its lines
   * condense out of cells, then fades in as the Grid script releases them into Life
   * (ADR 0004). It stays in the accessibility tree throughout, and its heading takes
   * focus once it's swapped in.
   */
  html.grid-on main.arriving:not(.released) {
    opacity: 0;
    pointer-events: none;
  }
  html.grid-on main.arriving.released {
    animation: arrive 500ms ease-out;
  }
  @keyframes arrive {
    from {
      opacity: 0;
    }
  }
</style>
