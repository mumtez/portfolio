---
import Analytics from "../components/Analytics.astro";
import SharingMeta from "../components/SharingMeta.astro";
import SiteNav from "../components/SiteNav.astro";
import { DARK, LIGHT, type Palette } from "../grid/palette";
import { getGridContent } from "../lib/content";
import { THEME_SCRIPT } from "../lib/preferences";

interface Props {
  title: string;
  description: string;
  /** This Section's path, for the nav. */
  path: string;
}

const { title, description, path } = Astro.props;
// What the Grid draws in cells, from the same content as this page. `<` is escaped so
// no heading can close the script element.
const gridContent = JSON.stringify(await getGridContent()).replace(/</g, "\\u003c");

// Both themes' colours, from the palettes the Grid draws with. Dark unless the system
// prefers light; a `data-theme` set by the theme script (or the toggle) overrides both.
const vars = (p: Palette) => `--bg: ${p.background}; --text: ${p.text}; --accent: ${p.pinned};`;
const themeCss = `
  :root { color-scheme: dark; ${vars(DARK)} }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]) { color-scheme: light; ${vars(LIGHT)} }
  }
  :root[data-theme="light"] { color-scheme: light; ${vars(LIGHT)} }
`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline set:html={THEME_SCRIPT} />
    <Fragment set:html={`<style>${themeCss}</style>`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <SharingMeta title={title} description={description} path={path} />
    <Analytics />
  </head>
  <body>
    <canvas id="grid" aria-hidden="true"></canvas>
    <header>
      <SiteNav current={path} />
      <div class="toggles" role="group" aria-label="Display" hidden>
        <button type="button" data-toggle="theme" data-label="Dark" aria-pressed="false">Dark theme</button>
        <button type="button" data-toggle="simulation" data-label="Life" aria-pressed="false">Life simulation</button>
      </div>
    </header>
    <slot />
    <script type="application/json" id="grid-content" set:html={gridContent} />
  </body>
</html>

<script>
  import type { GridContent } from "../grid/routes";
  import { startToggles } from "../grid/toggles";

  const canvas = document.querySelector<HTMLCanvasElement>("#grid");
  const data = document.querySelector("#grid-content")?.textContent;

  // The toggles start the Grid unless the simulation is off (by default under reduced
  // motion), which leaves the Plain View: no Grid, ordinary page loads.
  if (canvas && data) startToggles({ canvas, content: JSON.parse(data) as GridContent });
</script>

<style is:global>
  html {
    background: var(--bg);
    color: var(--text);
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
  }
  body {
    margin: 0;
  }
  a {
    color: var(--accent);
  }
  #grid {
    display: none;
  }

  /* Plain View: the toggles sit at the end of the header, beside the nav. */
  html:not(.grid-on) header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
  }
  .toggles {
    display: flex;
    gap: 8px;
    padding: 12px 16px;
  }
  .toggles[hidden] {
    display: none;
  }
  .toggles button {
    padding: 4px 10px;
    border: 1px solid var(--accent);
    border-radius: 4px;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }
  .toggles button[aria-pressed="true"] {
    background: var(--accent);
    color: var(--bg);
  }
  .toggles button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /*
   * Grid on: headings and the nav are drawn in Pinned Cells. The real nav links sit
   * transparently over their cells (placed by the Grid script), each h1 stays in the
   * accessibility tree but out of sight, and the Section's content scrolls in its own
   * box below the pinned title, over the live Grid.
   */
  html.grid-on #grid {
    display: block;
    position: fixed;
    inset: 0;
  }
  html.grid-on header {
    position: fixed;
    inset: 0 0 auto;
    height: 0;
    z-index: 2;
  }
  html.grid-on header nav > ul > li > a.on-grid {
    position: fixed;
    color: transparent;
    border-radius: 4px;
  }
  html.grid-on header nav > ul > li > a.on-grid:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  /* The toggles' real buttons, likewise, over the toggles drawn in the corner. */
  html.grid-on .toggles button.on-grid {
    position: fixed;
    padding: 0;
    border-color: transparent;
    background: transparent;
    color: transparent;
  }
  /* Deep Dive links aren't drawn in cells; they show like a skip link when focused. */
  html.grid-on header nav ul ul a,
  html.grid-on main h1 {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  html.grid-on header nav ul ul a:focus {
    position: fixed;
    left: 8px;
    bottom: 8px;
    width: auto;
    height: auto;
    margin: 0;
    padding: 6px 10px;
    clip-path: none;
    background: var(--bg);
    outline: 2px solid var(--accent);
  }
  html.grid-on main {
    position: fixed;
    top: calc(var(--below-title, 45vh) + 1.25rem);
    right: 0;
    bottom: var(--above-toggles, 0);
    left: 0;
    z-index: 1;
    overflow-y: auto;
    text-shadow: 0 0 6px var(--bg);
  }
  /*
   * A Section arriving in a Transition: its Body Text stays hidden while it condenses
   * out of cells, then fades in as the Grid script releases them into Life (ADR 0004).
   * It stays in the accessibility tree throughout, and its heading takes focus at once.
   */
  html.grid-on main.arriving:not(.released) {
    opacity: 0;
    pointer-events: none;
  }
  html.grid-on main.arriving.released {
    animation: arrive 500ms ease-out;
  }
  @keyframes arrive {
    from {
      opacity: 0;
    }
  }
</style>
