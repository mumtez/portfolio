---
import Base from "../layouts/Base.astro";
import { getProfile, getSection } from "../lib/content";

const home = await getSection("home");
const profile = await getProfile();
---

<Base title={home.title} description={home.description} path={home.path}>
  <main class="home">
    <h1>{home.heading}</h1>
    <p>{profile.tagline}</p>
  </main>
</Base>

<style>
  /* Plain View: the content as a centred page. */
  .home {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0 16px;
    text-align: center;
  }
  h1 {
    margin: 0;
    font-size: clamp(2rem, 6vw, 4rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  p {
    max-width: 40rem;
    font-size: 1.125rem;
    line-height: 1.5;
  }

  /* Grid on: the name is drawn in Pinned Cells, and the tagline sits just under it. */
  :global(html.grid-on) .home {
    display: block;
    min-height: 0;
  }
  :global(html.grid-on) p {
    margin: 0 auto;
  }
</style>
