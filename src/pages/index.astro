---
import Base from "../layouts/Base.astro";
import { getProfile, getSection } from "../lib/content";

const home = await getSection("home");
const profile = await getProfile();
---

<Base title={home.title} description={home.description} path={home.path}>
  <main class="home">
    <h1>{home.heading}</h1>
    <p data-panel="solid">{profile.tagline}</p>
  </main>
</Base>

<style>
  /* Plain View: the name in large type and the tagline, straight under the nav. */
  .home {
    max-width: 44rem;
    margin: 0 auto;
    padding: 40px 16px 64px;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 9vw, 4rem);
    line-height: 1.05;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  p {
    max-width: 36rem;
    margin: 0.875em 0 0;
    font-size: 1.125rem;
    line-height: 1.5;
  }

  /* Grid on: the name is drawn in Pinned Cells, and the tagline Panel sits centred just under it. */
  :global(html.grid-on) .home {
    max-width: none;
    margin: 0;
    padding: 0 16px;
    text-align: center;
  }
  :global(html.grid-on) p {
    max-width: 40rem;
    margin: 0 auto;
  }
</style>
