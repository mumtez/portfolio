---
/** A Deep Dive: one project's story, with its Markdown file body as Body Text and its Frames. */
import { readdirSync } from "node:fs";
import { join } from "node:path";
import type { GetStaticPaths } from "astro";
import Frame from "../../components/Frame.astro";
import Placeholder from "../../components/Placeholder.astro";
import Section from "../../layouts/Section.astro";
import { deepDivePath, getDeepDives, type Project } from "../../lib/content";
import { mediaDir, placeFrames } from "../../lib/frames";

export const getStaticPaths = (async () => {
  return (await getDeepDives()).map((project) => ({ params: { id: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, summary, tools, link, placeholder, frames } = project.data;
// Read at every build, so a dropped-in photo or video shows up with no code changes.
let files: string[] = [];
try {
  files = readdirSync(join(process.cwd(), mediaDir(project.id)));
} catch {
  // No media folder yet: every Frame shows its placeholder.
}
const parts = placeFrames(
  project.rendered?.html ?? "",
  frames.map((f) => f.slot),
);
const frameFor = (slot: string) => frames.find((f) => f.slot === slot)!;
---

<Section path={deepDivePath(project)} heading={title} title={`${title} · Andrew Aburustum`} description={summary}>
  <p class="meta">{tools}{link && <> · <a href={link.href}>{link.label}</a></>}</p>
  {placeholder && <Placeholder note={placeholder} />}
  <div class="body-text">
    {
      parts.map((part) =>
        "html" in part ? (
          <Fragment set:html={part.html} />
        ) : (
          <Frame deepDive={project.id} files={files} {...frameFor(part.frame)} />
        ),
      )
    }
  </div>
  <p><a href="/projects/">All projects</a></p>
</Section>
