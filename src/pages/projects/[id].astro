---
/**
 * A Deep Dive: one project's story, with its Markdown file body as Body Text, set in a solid
 * Panel per subheading, and its Frames between them.
 *
 * Above the title, a way back to Projects: in the Grid a Button Panel sized to a left
 * arrow, which the Grid draws in Cells inside its border (the link's text is hidden there
 * but still names it "All projects"); in Plain View an ordinary "← All projects" link.
 */
import { readdirSync } from "node:fs";
import { join } from "node:path";
import type { GetStaticPaths } from "astro";
import { cellIconButton, type CellIcon } from "../../grid/cell-typesetter";
import Frame from "../../components/Frame.astro";
import Placeholder from "../../components/Placeholder.astro";
import Section from "../../layouts/Section.astro";
import { deepDivePath, getDeepDives, type Project } from "../../lib/content";
import { frameMedia, mediaDir, panelBlocks, placeFrames } from "../../lib/frames";
import { SHOW_PLACEHOLDERS } from "../../lib/placeholders";

export const getStaticPaths = (async () => {
  return (await getDeepDives()).map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, summary, tools, link, placeholder, frames } = project.data;
// Read at every build, so a dropped-in photo or video shows up with no code changes.
let files: string[] = [];
try {
  files = readdirSync(join(process.cwd(), mediaDir(project.id)));
} catch {
  // No media folder yet: every Frame shows its placeholder.
}
const parts = placeFrames(
  project.rendered?.html ?? "",
  frames.map((f) => f.slot),
);
const frameFor = (slot: string) => frames.find((f) => f.slot === slot)!;
const BACK_ICON: CellIcon = "arrow-left";
const backButton = cellIconButton(BACK_ICON);
---

<Section
  deepDive
  path={deepDivePath(project)}
  heading={title}
  title={`${title} · Andrew Aburustum`}
  description={summary}
>
  <p class="back" slot="above-heading">
    <a
      href="/projects/"
      data-panel="button"
      data-cell-icon={BACK_ICON}
      style={`--button-cells: ${backButton.width}; --button-rows: ${backButton.height}`}
    >
      <span class="visually-hidden-on-grid">
        <span aria-hidden="true">← </span>All projects
      </span>
    </a>
  </p>
  <p class="meta">
    {tools}
    {link && (
      <>
        {" "}
        · <a href={link.href}>{link.label}</a>
      </>
    )}
  </p>
  {placeholder && SHOW_PLACEHOLDERS && <Placeholder note={placeholder} />}
  <div class="body-text">
    {parts.map((part) =>
      "html" in part ? (
        panelBlocks(part.html).map((block) => <section data-panel="solid" set:html={block} />)
      ) : SHOW_PLACEHOLDERS || frameMedia(project.id, part.frame, files) ? (
        <Frame deepDive={project.id} files={files} {...frameFor(part.frame)} />
      ) : null,
    )}
  </div>
</Section>

<style>
  /* The title sets tight under it, as it would at the top of the Section. */
  .back + :global(h1) {
    margin-top: 0;
  }

  /* Plain View: an ordinary link, not a Panel. */
  :global(html:not(.grid-on)) .back {
    margin: 0 0 0.75em;
  }
  :global(html:not(.grid-on)) .back a {
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
  }

  /*
   * Grid on: a Button Panel the size of its arrow in Cells, one clear cell and then the
   * border round it (the Typesetter's `cellIconButton`), at the top left of the column.
   * The arrow is drawn in Cells, so the link's text is hidden.
   */
  :global(html.grid-on) .back {
    margin: 0 0 1em;
    /* Room for its focus ring inside the scroll box. */
    padding-top: 6px;
  }
  :global(html.grid-on) .back a {
    display: block;
    width: calc(var(--button-cells) * var(--cell-px, 6px));
    height: calc(var(--button-rows) * var(--cell-px, 6px));
    margin: 0;
    padding: 0;
    border-radius: 4px;
  }
  :global(html.grid-on) .back a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /*
   * A wide screen, whose margin left of the column holds the link (the "← All projects"
   * text, the wider of the two) plus a 2rem gap: it's fixed there, its top level with
   * the title's, while the Body Text scrolls. `.back` takes no room, so the title sets
   * where it did, and the link hangs off its left. (`margin: 0` overrides each view's
   * margin above.) Narrower, it stays above the title and scrolls with the story.
   */
  @media (min-width: 64rem) {
    /*
     * Grid on: `.back` sticks to the top of `main`, the Body Text's scroll box, so the
     * link stays inside the box the Grid measures Panels in and its Cells stay put.
     */
    :global(html.grid-on) .back {
      position: sticky;
      top: 0;
      height: 0;
      margin: 0;
    }
    :global(html.grid-on) .back a {
      position: absolute;
      /* Below the focus ring's room: level with the title's top. */
      top: 100%;
      right: calc(100% + 2rem);
    }
    /* Plain View: the page scrolls, so the link is fixed where it would sit, at the title's top. */
    :global(html:not(.grid-on)) .back {
      height: 0;
      margin: 0;
    }
    :global(html:not(.grid-on)) .back a {
      position: fixed;
      transform: translateX(calc(-100% - 2rem));
      white-space: nowrap;
    }
  }
</style>
