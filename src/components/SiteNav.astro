---
/**
 * Plain HTML nav linking the five top-level Sections. Deep Dives aren't in it: they're
 * reached from their Project Entries.
 */
import { currentness } from "../grid/routes";
import { getSections } from "../lib/content";

interface Props {
  /** The current Section's path; its link, and Projects on a Deep Dive, get aria-current. */
  current: string;
}

const { current } = Astro.props;
const sections = await getSections();
---

<nav aria-label="Sections">
  <ul>
    {sections.map((section) => (
      <li>
        <a href={section.path} aria-current={currentness(section.path, current)}>
          {section.nav}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px clamp(12px, 3.5vw, 22px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /*
   * Plain View: a quiet row of links, the current Section marked in the pinned green
   * with an underline, like the Grid's underlined nav Button. With the Grid on, the
   * links are laid transparently over their drawn Buttons instead.
   */
  :global(html:not(.grid-on)) a {
    padding: 4px 0;
    color: var(--text);
    text-decoration: none;
    letter-spacing: 0.02em;
  }
  :global(html:not(.grid-on)) a:hover {
    text-decoration: underline 1px;
    text-underline-offset: 6px;
  }
  :global(html:not(.grid-on)) a[aria-current] {
    color: var(--accent);
    font-weight: 600;
    text-decoration: underline 2px;
    text-underline-offset: 6px;
  }
</style>
