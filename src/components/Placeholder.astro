---
/**
 * Marks content still waiting for Andrew's own words or media. Every one is listed in
 * PLACEHOLDERS.md. It's a dashed Panel, unless it fills one already (a Frame waiting for
 * its media, whose slot is then the dashed Panel).
 */
interface Props {
  /** What's missing. */
  note: string;
  /** False when it fills a Panel that's already marked. */
  panel?: boolean;
}

const { note, panel = true } = Astro.props;
---

<p class="placeholder" data-panel={panel ? "dashed" : undefined}>
  <strong>Placeholder:</strong> {note}
</p>

<style>
  .placeholder {
    font-style: italic;
  }
</style>
