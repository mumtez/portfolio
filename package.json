{
  "name": "portfolio",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run --project unit",
    "test:site": "SHOW_PLACEHOLDERS=true astro build && vitest run --project site",
    "test:e2e": "SHOW_PLACEHOLDERS=true astro build && playwright test",
    "test:all": "npm run format:check && npm run check && npm test && npm run test:live && npm run test:site && npm run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:live": "astro build && vitest run --project live"
  },
  "dependencies": {
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "linkedom": "^0.18.13",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
